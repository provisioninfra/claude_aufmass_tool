# Aufmaß-Werkzeug: Schutzkopfzeilen für diesen Ordner (Apache).
#
# Die Inhaltsrichtlinie (CSP) steht in den Seiten selbst. Was eine Seite
# nicht selbst setzen kann, steht hier: keine Einbettung in fremde Seiten,
# keine Typ-Rätselei, keine Verweisadresse nach außen, Kamera und Mikrofon
# nur für die eigene Seite. Seiten, Skripte und der Service Worker liegen
# nie lange im Browser-Cache - sonst bliebe ein Gerät auf einer alten
# Fassung. Alles ist in IfModule-Blöcke gefasst: Fehlt ein Modul, wird der
# Block übergangen, statt den Ordner lahmzulegen.
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(), usb=()"
  <FilesMatch "\.(html|js|css|webmanifest)$">
    Header always set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
</IfModule>
